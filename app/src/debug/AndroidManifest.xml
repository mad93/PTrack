<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- AGP 8.2 lint checks the variant manifest before merging main.
             Repeat the existing type so its FGS check can see it; no behavior change. -->
        <service android:name=".RecordingService"
            android:foregroundServiceType="connectedDevice|location" />
        <meta-data android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <meta-data android:name="androidx.car.app.minCarApiLevel" android:value="1" />
        <!-- Experimental template transport probe, not a claim of IoT product eligibility.
             See docs/ANDROID-AUTO-MINIMAL.md for host / installation restrictions. -->
        <service android:name=".car.PTrackCarAppService" android:exported="true"
            android:label="PTrack" android:icon="@drawable/ic_ptrack">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.IOT" />
            </intent-filter>
        </service>
    </application>
</manifest>
